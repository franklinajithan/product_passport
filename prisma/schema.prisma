generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANUFACTURER
  DISTRIBUTOR
  RETAILER
  DEVELOPER
  CONSUMER
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum OrganisationType {
  MANUFACTURER
  BRAND_OWNER
  DISTRIBUTOR
  RETAILER
}

enum OrganisationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OrganisationMemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
  RECALLED
  ARCHIVED
}

enum VerificationLevel {
  COMMUNITY
  DISTRIBUTOR_VERIFIED
  MANUFACTURER_VERIFIED
}

enum BarcodeType {
  EAN_13
  EAN_8
  UPC_A
  UPC_E
  GTIN_14
  ISBN
  INTERNAL
}

enum ImageType {
  FRONT
  BACK
  LEFT
  RIGHT
  TOP
  BOTTOM
  INGREDIENTS
  NUTRITION
  BARCODE
  PACKAGING
  OTHER
}

enum AllergenPresence {
  CONTAINS
  MAY_CONTAIN
  FREE_FROM
}

enum MeasurementUnit {
  G
  KG
  ML
  L
  OZ
  LB
  PIECES
}

enum NutritionBasis {
  PER_100G
  PER_100ML
  PER_SERVING
}

enum PackagingType {
  BOTTLE
  JAR
  CAN
  BOX
  BAG
  TRAY
  POUCH
  CARTON
  OTHER
}

enum PackagingMaterial {
  PLASTIC
  GLASS
  PAPER
  ALUMINIUM
  STEEL
  MIXED
  OTHER
}

enum IngredientKind {
  INGREDIENT
  ADDITIVE
  PRESERVATIVE
  COLOUR
  FLAVOURING
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ProductReportReason {
  WRONG_NAME
  WRONG_IMAGE
  WRONG_INGREDIENTS
  WRONG_WEIGHT
  WRONG_MANUFACTURER
  WRONG_BARCODE
  PRODUCT_DISCONTINUED
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role          UserRole   @default(CONSUMER)
  status        UserStatus @default(PENDING_EMAIL_VERIFICATION)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts               Account[]
  sessions               Session[]
  memberships            OrganisationMember[]
  organisationInvites    OrganisationInvite[] @relation("InviteInviter")
  acceptedInvites        OrganisationInvite[] @relation("InviteAcceptedBy")
  auditLogs              AuditLog[]
  productVersions        ProductVersion[]
  claims                 ProductClaim[]
  reports                ProductReport[]
  apiKeys                APIKey[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  subscriptions          Subscription[]
  assignedDuplicates     DuplicateCandidate[] @relation("DuplicateReviewer")

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Country {
  id        String   @id @default(uuid())
  iso2      String   @unique
  iso3      String   @unique
  name      String
  numeric   String?
  createdAt DateTime @default(now())

  organisations          Organisation[]
  manufacturers          Manufacturer[]
  distributors           Distributor[]
  originProducts         Product[]         @relation("ProductOriginCountry")
  productCountries       ProductCountry[]
  recallCountries        ProductRecallCountry[]

  @@index([name])
}

model Language {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  nativeName   String
  isRecommended Boolean @default(false)
  isRtl        Boolean  @default(false)
  createdAt    DateTime @default(now())

  translations         ProductTranslation[]
  ingredientNames      IngredientTranslation[]
  images               ProductImage[]
}

model Category {
  id          String   @id @default(uuid())
  parentId    String?
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  products   Product[]  @relation("ProductCategory")
  subProducts Product[] @relation("ProductSubcategory")

  @@index([parentId])
  @@index([name])
}

model Organisation {
  id                 String             @id @default(uuid())
  type               OrganisationType
  name               String
  legalName          String
  registrationNumber String?
  vatNumber          String?
  countryId          String
  addressLine1       String
  addressLine2       String?
  city               String
  region             String?
  postalCode         String
  website            String?
  businessEmail      String
  contactPerson      String
  phone              String
  gs1CompanyPrefix   String?
  status             OrganisationStatus @default(PENDING_VERIFICATION)
  verificationNote   String?            @db.Text
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  country        Country               @relation(fields: [countryId], references: [id])
  members        OrganisationMember[]
  invites        OrganisationInvite[]
  brands         Brand[]
  manufacturers  Manufacturer[]
  distributor    Distributor?
  products       Product[]
  apiKeys        APIKey[]
  subscriptions  Subscription[]
  claims         ProductClaim[]
  reportsReceived ProductReport[]      @relation("OrganisationReports")
  audits         AuditLog[]

  @@index([status])
  @@index([type])
  @@index([name])
  @@index([createdAt])
  @@index([countryId])
}

model OrganisationMember {
  id             String                 @id @default(uuid())
  organisationId String
  userId         String
  role           OrganisationMemberRole @default(EDITOR)
  createdAt      DateTime               @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
}

model OrganisationInvite {
  id             String                 @id @default(uuid())
  organisationId String
  email          String
  role           OrganisationMemberRole @default(EDITOR)
  tokenHash      String                 @unique
  status         InviteStatus           @default(PENDING)
  invitedById    String
  acceptedById   String?
  expiresAt      DateTime
  createdAt      DateTime               @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteInviter", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InviteAcceptedBy", fields: [acceptedById], references: [id])

  @@index([organisationId, email])
}

model Brand {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  slug           String
  description    String?  @db.Text
  website        String?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organisationId, slug])
  @@index([name])
  @@index([organisationId])
}

model Manufacturer {
  id             String   @id @default(uuid())
  organisationId String?
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  postalCode     String?
  countryId      String
  website        String?
  contactEmail   String?
  contactPhone   String?
  factoryName    String?
  factoryAddress String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  country      Country       @relation(fields: [countryId], references: [id])
  products     Product[]

  @@index([name])
  @@index([organisationId])
  @@index([countryId])
}

model Distributor {
  id             String   @id @default(uuid())
  organisationId String   @unique
  tradingName    String
  addressLine1   String?
  city           String?
  postalCode     String?
  countryId      String
  website        String?
  contactEmail   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  country      Country      @relation(fields: [countryId], references: [id])
  products     ProductDistributor[]
}

model Product {
  id                 String            @id @default(uuid())
  publicNumber       Int               @unique @default(autoincrement())
  gprId              String            @unique
  sku                String?
  organisationId     String
  brandId            String
  manufacturerId     String
  categoryId         String?
  subcategoryId      String?
  productType        String?
  originCountryId    String?
  status             ProductStatus     @default(DRAFT)
  verification       VerificationLevel @default(COMMUNITY)
  lastVerifiedAt     DateTime?
  completenessScore  Int               @default(0)
  isDuplicateOfId    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organisation  Organisation  @relation(fields: [organisationId], references: [id])
  brand         Brand         @relation(fields: [brandId], references: [id])
  manufacturer  Manufacturer  @relation(fields: [manufacturerId], references: [id])
  category      Category?     @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategory   Category?     @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  originCountry Country?      @relation("ProductOriginCountry", fields: [originCountryId], references: [id])
  duplicateOf   Product?      @relation("ProductDuplicates", fields: [isDuplicateOfId], references: [id])
  duplicates    Product[]     @relation("ProductDuplicates")

  barcodes       ProductBarcode[]
  translations   ProductTranslation[]
  images         ProductImage[]
  measurement    ProductMeasurement?
  nutrition      Nutrition?
  packaging      Packaging?
  ingredients    ProductIngredient[]
  allergens      ProductAllergen[]
  certifications ProductCertification[]
  countries      ProductCountry[]
  distributors   ProductDistributor[]
  versions       ProductVersion[]
  claims         ProductClaim[]
  reports        ProductReport[]
  recalls        ProductRecall[]
  variants       ProductVariant[] @relation("VariantParent")
  parentVariant  ProductVariant?  @relation("VariantChild")
  duplicateLeft  DuplicateCandidate[] @relation("DuplicateProductA")
  duplicateRight DuplicateCandidate[] @relation("DuplicateProductB")
  catalogueItems RetailerCatalogueItem[]

  @@index([organisationId])
  @@index([brandId])
  @@index([manufacturerId])
  @@index([status])
  @@index([verification])
  @@index([createdAt])
  @@index([categoryId])
  @@index([gprId])
}

model ProductVariant {
  id           String   @id @default(uuid())
  parentId     String
  variantId    String   @unique
  variantLabel String
  createdAt    DateTime @default(now())

  parent  Product @relation("VariantParent", fields: [parentId], references: [id], onDelete: Cascade)
  variant Product @relation("VariantChild", fields: [variantId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

model ProductBarcode {
  id          String      @id @default(uuid())
  productId   String
  value       String
  type        BarcodeType
  isPrimary   Boolean     @default(true)
  isOfficial  Boolean     @default(true)
  createdAt   DateTime    @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([value])
  @@index([productId])
  @@index([type])
}

model ProductTranslation {
  id                   String   @id @default(uuid())
  productId            String
  languageCode         String
  productName          String
  description          String?  @db.Text
  ingredients          String?  @db.Text
  usageInstructions    String?  @db.Text
  storageInstructions  String?  @db.Text
  warningText          String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageCode], references: [code])

  @@unique([productId, languageCode])
  @@index([productName])
  @@index([languageCode])
}

model ProductImage {
  id           String    @id @default(uuid())
  productId    String
  type         ImageType
  url          String
  thumbnailUrl String?
  altText      String?
  caption      String?
  languageCode String?
  sortOrder    Int       @default(0)
  isMain       Boolean   @default(false)
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  language Language? @relation(fields: [languageCode], references: [code])

  @@index([productId, sortOrder])
}

model ProductMeasurement {
  id               String           @id @default(uuid())
  productId        String           @unique
  netWeightValue   Decimal?         @db.Decimal(12, 4)
  netWeightUnit    MeasurementUnit?
  netVolumeValue   Decimal?         @db.Decimal(12, 4)
  netVolumeUnit    MeasurementUnit?
  packQuantity     Int?
  pieceCount       Int?
  lengthMm         Decimal?         @db.Decimal(12, 2)
  widthMm          Decimal?         @db.Decimal(12, 2)
  heightMm         Decimal?         @db.Decimal(12, 2)
  grossWeightValue Decimal?         @db.Decimal(12, 4)
  grossWeightUnit  MeasurementUnit?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Ingredient {
  id        String   @id @default(uuid())
  code      String?  @unique
  kind      IngredientKind @default(INGREDIENT)
  createdAt DateTime @default(now())

  translations IngredientTranslation[]
  products     ProductIngredient[]
}

model IngredientTranslation {
  id           String @id @default(uuid())
  ingredientId String
  languageCode String
  name         String

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  language   Language   @relation(fields: [languageCode], references: [code])

  @@unique([ingredientId, languageCode])
  @@index([name])
}

model ProductIngredient {
  id           String         @id @default(uuid())
  productId    String
  ingredientId String?
  kind         IngredientKind @default(INGREDIENT)
  percentage   Decimal?       @db.Decimal(6, 3)
  sortOrder    Int            @default(0)
  rawText      String?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])

  @@index([productId, sortOrder])
}

model Allergen {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  products ProductAllergen[]
}

model ProductAllergen {
  id         String           @id @default(uuid())
  productId  String
  allergenId String
  presence   AllergenPresence

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id])

  @@unique([productId, allergenId])
}

model Nutrition {
  id               String         @id @default(uuid())
  productId        String         @unique
  basis            NutritionBasis @default(PER_100G)
  servingSizeValue Decimal?       @db.Decimal(12, 4)
  servingSizeUnit  MeasurementUnit?
  energyKcal       Decimal?       @db.Decimal(12, 4)
  energyKj         Decimal?       @db.Decimal(12, 4)
  fat              Decimal?       @db.Decimal(12, 4)
  saturatedFat     Decimal?       @db.Decimal(12, 4)
  carbohydrate     Decimal?       @db.Decimal(12, 4)
  sugars           Decimal?       @db.Decimal(12, 4)
  fibre            Decimal?       @db.Decimal(12, 4)
  protein          Decimal?       @db.Decimal(12, 4)
  salt             Decimal?       @db.Decimal(12, 4)
  sodium           Decimal?       @db.Decimal(12, 4)

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  extras    NutritionNutrient[]
}

model NutritionNutrient {
  id          String  @id @default(uuid())
  nutritionId String
  code        String
  name        String
  value       Decimal @db.Decimal(12, 4)
  unit        String

  nutrition Nutrition @relation(fields: [nutritionId], references: [id], onDelete: Cascade)

  @@unique([nutritionId, code])
}

model Certification {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  products ProductCertification[]
}

model ProductCertification {
  id                   String    @id @default(uuid())
  productId            String
  certificationId      String
  certificateNumber    String?
  issuingOrganisation  String?
  issuedAt             DateTime?
  expiresAt            DateTime?
  documentUrl          String?
  evidenceVerified     Boolean   @default(false)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  certification  Certification  @relation(fields: [certificationId], references: [id])

  @@index([productId])
}

model Packaging {
  id               String             @id @default(uuid())
  productId        String             @unique
  type             PackagingType
  material         PackagingMaterial
  recyclingNotes   String?            @db.Text
  isRecyclable     Boolean?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductCountry {
  id        String @id @default(uuid())
  productId String
  countryId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id])

  @@unique([productId, countryId])
}

model ProductDistributor {
  id             String @id @default(uuid())
  productId      String
  distributorId  String

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([productId, distributorId])
}

model ProductVersion {
  id            String   @id @default(uuid())
  productId     String
  changedField  String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  changedById   String?
  reason        String?
  createdAt     DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([changedById])
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  organisationId String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@index([organisationId])
}

model ProductClaim {
  id             String      @id @default(uuid())
  productId      String
  organisationId String
  claimantId     String
  evidenceUrl    String?
  evidenceNote   String?     @db.Text
  status         ClaimStatus @default(PENDING)
  reviewNote     String?     @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  claimant     User         @relation(fields: [claimantId], references: [id])

  @@index([status])
  @@index([productId])
}

model ProductReport {
  id               String               @id @default(uuid())
  productId        String
  reporterId       String?
  reporterEmail    String?
  organisationId   String?
  reason           ProductReportReason
  details          String?              @db.Text
  status           ReportStatus         @default(OPEN)
  createdAt        DateTime             @default(now())
  resolvedAt       DateTime?

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter     User?         @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  organisation Organisation? @relation("OrganisationReports", fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([productId])
}

model ProductRecall {
  id                    String   @id @default(uuid())
  productId             String
  reason                String   @db.Text
  recalledAt            DateTime
  batchNumbers          String?
  consumerInstructions  String   @db.Text
  createdAt             DateTime @default(now())

  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  countries ProductRecallCountry[]
}

model ProductRecallCountry {
  id        String @id @default(uuid())
  recallId  String
  countryId String

  recall  ProductRecall @relation(fields: [recallId], references: [id], onDelete: Cascade)
  country Country       @relation(fields: [countryId], references: [id])

  @@unique([recallId, countryId])
}

model DuplicateCandidate {
  id           String    @id @default(uuid())
  productAId   String
  productBId   String
  score        Int
  reasons      Json
  status       String    @default("OPEN")
  reviewedById String?
  createdAt    DateTime  @default(now())

  productA   Product @relation("DuplicateProductA", fields: [productAId], references: [id], onDelete: Cascade)
  productB   Product @relation("DuplicateProductB", fields: [productBId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("DuplicateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

model APIKey {
  id             String    @id @default(uuid())
  userId         String
  organisationId String?
  name           String
  keyPrefix      String
  keyHash        String    @unique
  permissions    Json
  planSnapshot   SubscriptionPlan @default(FREE)
  monthlyLimit   Int       @default(10000)
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  usage        APIUsage[]

  @@index([userId])
  @@index([organisationId])
  @@index([keyPrefix])
}

model APIUsage {
  id         String   @id @default(uuid())
  apiKeyId   String
  occurredAt DateTime @default(now())
  endpoint   String
  method     String
  statusCode Int
  ipAddress  String?

  apiKey APIKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, occurredAt])
  @@index([occurredAt])
}

model Subscription {
  id                   String             @id @default(uuid())
  organisationId       String?
  userId               String?
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  monthlyRequestLimit  Int                @default(10000)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan, status])
}

model RateLimitSetting {
  id        String @id @default(uuid())
  plan      SubscriptionPlan @unique
  monthlyRequestLimit Int
  burstPerMinute      Int
  updatedAt DateTime @updatedAt
}

model RetailerCatalogueItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}
